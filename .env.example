# Example environment variables for OneiTech_WV1.0
# Copy to .env or configure in your host control panel

# SMTP settings for contact form
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password

# Destination email for contact form messages
CONTACT_TO_EMAIL=you@yourcompany.com
CONTACT_FROM_EMAIL=website@yourdomain.com

# Next.js specific
# PORT (optional) - default 3000
# PORT=3000

# Add any other NEXT_PUBLIC_... vars here
# NEXT_PUBLIC_ANALYTICS_ID=xxxx
